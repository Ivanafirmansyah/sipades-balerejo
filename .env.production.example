# =========================================================
# SIPADES — contoh pengaturan untuk HOSTING (production)
# Salin menjadi .env di server hosting, lalu isi nilai yang kosong.
# =========================================================

APP_NAME=SIPADES
# production = HTTPS dipaksa, cookie sesi "secure", header HSTS aktif
APP_ENV=production
APP_KEY=
# WAJIB false di hosting: error tidak menampilkan detail kode/server
APP_DEBUG=false
# Wajib diawali https://
APP_URL=https://nama-desa.desa.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Hanya catat error (jangan catat data permintaan warga)
LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Isi sesi dienkripsi di database
SESSION_ENCRYPT=true
# Cookie sesi hanya lewat HTTPS
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Isi "*" bila hosting memakai proxy / CDN (mis. Cloudflare) di depan server,
# agar aplikasi tahu koneksi warga sebenarnya HTTPS. Kosongkan bila tidak.
TRUSTED_PROXIES=
